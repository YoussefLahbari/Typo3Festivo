<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
  <sheets>
    <sDEF>
      <ROOT>
        <sheetTitle>LLL:EXT:festivo/Resources/Private/Language/locallang_be.xlf:flexform.sheetConfig</sheetTitle>
        <type>array</type>
        <el>
          <settings.showSearchbar>
            <label>Show Searchbar</label>
            <config>
              <type>check</type>
              <default>1</default>
            </config>
          </settings.showSearchbar>

          <settings.showTagsFilter>
            <label>Show Tags Filter</label>
            <config>
              <type>check</type>
              <default>0</default>
            </config>
          </settings.showTagsFilter>

          <settings.storagePid>
            <label>Choose Events Storage Folder</label>
            <config>
              <type>group</type>
              <allowed>pages</allowed>
              <size>5</size>
              <maxitems>10</maxitems>
              <minitems>0</minitems>
            </config>
          </settings.storagePid>
        </el>
      </ROOT>
    </sDEF>
  </sheets>
</T3DataStructure>
