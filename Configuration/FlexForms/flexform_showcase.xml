<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
  <sheets>
    <!--
      ################################
        SHEET General Settings
      ################################
    -->
    <sDEF>
      <ROOT>
          <sheetTitle>LLL:EXT:festivo/Resources/Private/Language/locallang_be.xlf:flexform.sheetConfig</sheetTitle>
        <type>array</type>
        <el>

          <!-- Show Searchbar -->
          <settings.showSearchbar>
              <label>Show Searchbar</label>
              <config>
                <type>check</type>
                <default>1</default>
              </config>
          </settings.showSearchbar>
          
          <!-- Show Tags Filter -->
          <settings.showTagsFilter>
              <label>Show Tags Filter</label>
              <config>
                <type>check</type>
                <default>0</default>
              </config>
          </settings.showTagsFilter>

          <!-- Storage PID -->
          <settings.storagePid>
              <label>Choose Events Storage Folder</label>
              <config>
                <type>group</type>
                <internal_type>db</internal_type>
                <allowed>pages</allowed>
                <size>10</size>
                <maxitems>10</maxitems>
                <minitems>0</minitems>
              </config>
          </settings.storagePid>

        </el>
      </ROOT>
    </sDEF>

    <!--
      ################################
        SHEET Design Settings
      ################################
    -->

  </sheets>
</T3DataStructure>