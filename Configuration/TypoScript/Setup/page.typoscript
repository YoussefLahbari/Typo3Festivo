page = PAGE
page {
    typeNum = 0
    shortcutIcon = {$page.favicon.file}

    bodyTagCObject = COA
    bodyTagCObject {
        10 = TEXT
        10.data = TSFE:id
        10.noTrimWrap = | id="p|"|
        20 =< lib.page.class
        20.stdWrap.noTrimWrap = | class="|"|
        wrap = <body|>
    }

    10 = FLUIDTEMPLATE
    10 {
        templateName = TEXT
        templateName {
            cObject = TEXT
            cObject {
                data = pagelayout
                required = 1
                case = uppercamelcase
                split {
                    token = pagets__
                    cObjNum = 1
                    1.current = 1
                }
            }
            ifEmpty = Default
        }

        templateRootPaths {
            0 = EXT:festivo/Resources/Private/Templates/Page/
        }
        partialRootPaths {
            0 = EXT:festivo/Resources/Private/Partials/Page/
        }
        layoutRootPaths {
            0 = EXT:festivo/Resources/Private/Layouts/Page/
        }
    }

    includeCSS {
        theme = EXT:festivo/Resources/Public/Css/main.css
        eventList = EXT:festivo/Resources/Public/Css/eventslist.css
        searchbar = EXT:festivo/Resources/Public/Css/searchbar.css
    }

    includeJSFooter {
        searchbar = EXT:festivo/Resources/Public/JavaScript/searchbar.js
    }
}
