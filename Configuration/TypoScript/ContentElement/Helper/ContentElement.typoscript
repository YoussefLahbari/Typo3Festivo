lib.contentElement = FLUIDTEMPLATE
lib.contentElement {
    templateName = Default
    templateRootPaths {
        10 = {$plugin.festivo_contentelements.view.templateRootPath}
    }
    partialRootPaths {
        10 = {$plugin.festivo_contentelements.view.partialRootPath}
    }
    layoutRootPaths {
        10 = {$plugin.festivo_contentelements.view.layoutRootPath}
    }

    variables {
        backendlayout = TEXT
        backendlayout {
            data = pagelayout
            replacement.10 {
                search = pagets__
                replace =
            }
            ifEmpty = default
        }
    }
}
